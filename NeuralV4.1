  0  \n","2         0         0         0         0  \n","3         0         0         0         0  \n","4         0         0         0         0  \n","\n","[5 rows x 785 columns]"]},"execution_count":2,"metadata":{},"output_type":"execute_result"}],"source":["data.head()#dataframe do panda de pixels ate 783"]},{"cell_type":"code","execution_count":3,"id":"bfbb0562","metadata":{"execution":{"iopub.execute_input":"2026-10-08T21:02:18.618648Z","iopub.status.busy":"2026-10-08T21:02:18.61709Z","iopub.status.idle":"2026-10-08T21:02:19.53986Z","shell.execute_reply":"2026-10-08T21:02:19.538229Z"},"papermill":{"duration":0.930969,"end_time":"2026-10-08T21:02:19.543158","exception":false,"start_time":"2026-10-08T21:02:18.612189","status":"completed"},"tags":[]},"outputs":[],"source":["#Caixa dos dados\n","data = np.array(data) #especificacao para trabalhar com os arrays do numpy\n","m, n = data.shape# m = quantidade de linhas/exemplos que se tem (Rows) / n = quantidade de recursos + 1 por causa da coluna de etiqueta (numeraçao e rotulos)\n","np.random.shuffle(data) #dividindo o leitor de data dos arrays em dev e train para que o lixo de memoria de Desenvolvimento nao entre no treinamento das bias, remove o risco de sobreajuste\n","\n","#numero de 0 ate N exemplos que serao alocados em data dev.(0 a 1000 pq sim). T e a transposta das matrizes dos pixels pq cada coluna vira um exemplo e nao cada linha (coluna vira exemplo )\n","data_dev = data[0:1000].T\n","Y_dev = data_dev[0]\n","X_dev = data_dev[1:n]\n","X_dev = X_dev / 255.\n","\n"," #todo o resto vira dado de treino, transposta  pelo mesmo motivo do dev\n","data_train = data[1000:m].T\n","Y_train = data_train[0]\n","X_train = data_train[1:n]\n","X_train = X_train / 255.\n","_,m_train = X_train.shape"]},{"cell_type":"code","execution_count":4,"id":"9e8c8292","metadata":{"execution":{"iopub.execute_input":"2026-10-08T21:02:19.552656Z","iopub.status.busy":"2026-10-08T21:02:19.552314Z","iopub.status.idle":"2026-10-08T21:02:19.567186Z","shell.execute_reply":"2026-10-08T21:02:19.565815Z"},"papermill":{"duration":0.023884,"end_time":"2026-10-08T21:02:19.570547","exception":false,"start_time":"2026-10-08T21:02:19.546663","status":"completed"},"tags":[]},"outputs":[],"source":["#Recolado tudo e algumas mod das Vn<V4 anteriores\n","def init_params(): #parametros de iniciaçao, variaveis que vao na equaçao\n","    \n","    W1 = np.random.normal(size=(10, 784)) * np.sqrt(2.0/(784)) #roubei de um blog\n","    b1 = np.random.normal(size=(10, 1)) #divisao vai dar um valor de 0 a 1 para a precisao da prediction no treino, q vai usar no softmax\n","    \n","    W2 = np.random.normal(size=(10, 10)) * np.sqrt(2.0/10)\n","    b2 = np.random.normal(size=(10, 1)) \n","    \n","    \n","    return W1, b1, W2, b2\n","\n","def ReLU(Z): # Funçao linear X se X>0 e 0 se X<=0, ou seja ela passa por todo elemento de Z, se Z>0 retorna Z se Z<0 retorna 0\n","    return np.maximum(Z, 0)\n","\n","def softmax(Z): #Equaçao de ativaçao de funçao softmax, entra os dados a output layer e sai os numeros probabilidades \n","    A = np.exp(Z) / sum(np.exp(Z)) # soma de cada coluna das linhas dividido pelos elementos delas, calculo da probilidade\n","    return A\n","    \n","def forward_prop(W1, b1, W2, b2, X): #propragaçao direta, passagem dos dados da camada de input\n","    Z1 = W1.dot(X) + b1 #declarando mais variaveis\n","    A1 = ReLU(Z1)\n","    Z2 = W2.dot(A1) + b2\n","    A2 = softmax(Z2) #poderia usar a funçao sigmoid que faz a multiplicaçao dos weights (em matriz) pelas ativaçoes da primeira camada (em vetor), multiplicando linha por coluna e tambem somando com as Bias \"Vies\"(em vetor)\n","    return Z1, A1, Z2, A2\n","\n","def ReLU_deriv(Z): #Derivada do ReLU que e a equaçao de ativaçao 1\n","    return Z > 0\n","\n","def one_hot(Y): #Criador de matriz\n","    one_hot_Y = np.zeros((Y.size, Y.max() + 1)) #Cria matriz de zeros (parenteses e o tamanho dela)\n","    one_hot_Y[np.arange(Y.size), Y] = 1 #Cria um array de 0 a M numeros de exemplos de treinamento, diz que pra cada lina va para  a coluna de acesso em Y especificada pelo rotulo, e especifica ela como 1\n","    one_hot_Y = one_hot_Y.T #Transposta, para transformar cada coluna em exemplo e cada linha em rotulo\n","    return one_hot_Y\n","\n","def backward_prop(Z1, A1, Z2, A2, W1, W2, X, Y): # Algoritimo de Backward propagation, conjunto de equaçoes **** Atençao isso da erro lembra, \n","    one_hot_Y = one_hot(Y) # equaçoes\n","    dZ2 = A2 - one_hot_Y #variaveis novas\n","    dW2 = 1 / m * dZ2.dot(A1.T)\n","    db2 = 1 / m * np.sum(dZ2)\n","    dZ1 = W2.T.dot(dZ2) * ReLU_deriv(Z1) #a deriv e pra aqui lembra, caso de erro e aqui\n","    dW1 = 1 / m * dZ1.dot(X.T)\n","    db1 = 1 / m * np.sum(dZ1)\n","    return dW1, db1, dW2, db2\n","\n","def update_params(W1, b1, W2, b2, dW1, db1, dW2, db2, alpha): #atualizador de parametros\n","    W1 = W1 - alpha * dW1 #equaçoes dentro das variaveis\n","    b1 = b1 - alpha * db1    \n","    W2 = W2 - alpha * dW2  \n","    b2 = b2 - alpha * db2    \n","    return W1, b1, W2, b2"]},{"cell_type":"code","execution_count":5,"id":"5e44568a","metadata":{"execution":{"iopub.execute_input":"2026-10-08T21:02:19.579487Z","iopub.status.busy":"2026-10-08T21:02:19.579052Z","iopub.status.idle":"2026-10-08T21:02:19.588208Z","shell.execute_reply":"2026-10-08T21:02:19.586877Z"},"papermill":{"duration":0.016972,"end_time":"2026-10-08T21:02:19.591138","exception":false,"start_time":"2026-10-08T21:02:19.574166","status":"completed"},"tags":[]},"outputs":[],"source":["#Gradiente descendente ***************** DA MUITO PROBLEMA POR CAUSA DE VARIAVEIS ACIMA NO COMEÇO REVISA TUDO ANTES DE RODAR\n","def get_predictions(A2): #roubei do japones\n","    return np.argmax(A2, 0)\n","\n","def get_accuracy(predictions, Y):#roubei do japones\n","    print(predictions, Y)\n","    return np.sum(predictions == Y) / Y.size\n","\n","def gradient_descent(X, Y, alpha, iterations):\n","    W1, b1, W2, b2 = init_params()\n","    for i in range(iterations): #********** DA PAU REVISA AS VARIAVEIS TODAS ABAIXO NA CELULA ACIMA\n","        Z1, A1, Z2, A2 = forward_prop(W1, b1, W2, b2, X)\n","        dW1, db1, dW2, db2 = backward_prop(Z1, A1, Z2, A2, W1, W2, X, Y)\n","        W1, b1, W2, b2 = update_params(W1, b1, W2, b2, dW1, db1, dW2, db2, alpha)\n","        if i % 10 == 0: # NAO BOTAR O I COMO 50 \n","            print(\"Iteration: \", i)\n","            predictions = get_predictions(A2)\n","            print(get_accuracy(predictions, Y))\n","    return W1, b1, W2, b2"]},{"cell_type":"code","execution_count":6,"id":"32b6eb3a","metadata":{"execution":{"iopub.execute_input":"2026-10-08T21:02:19.600107Z","iopub.status.busy":"2026-10-08T21:02:19.599549Z","iopub.status.idle":"2026-10-08T21:04:16.275761Z","shell.execute_reply":"2026-10-08T21:04:16.274678Z"},"papermill":{"duration":116.685723,"end_time":"2026-10-08T21:04:16.27996","exception":false,"start_time":"2026-10-08T21:02:19.594237","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Iteration:  0\n","[1 1 1 ... 1 1 1] [8 8 7 ... 4 7 4]\n","0.11375609756097561\n","Iteration:  10\n","[1 1 1 ... 2 2 3] [8 8 7 ... 4 7 4]\n","0.3202439024390244\n","Iteration:  20\n","[1 1 9 ... 2 2 3] [8 8 7 ... 4 7 4]\n","0.444609756097561\n","Iteration:  30\n","[8 1 7 ... 4 7 4] [8 8 7 ... 4 7 4]\n","0.6397804878048781\n","Iteration:  40\n","[8 1 7 ... 4 7 4] [8 8 7 ... 4 7 4]\n","0.6937317073170731\n","Iteration:  50\n","[8 1 7 ... 4 7 4] [8 8 7 ... 4 7 4]\n","0.7182926829268292\n","Iteration:  60\n","[8 1 7 ... 4 7 4] [8 8 7 ... 4 7 4]\n","0.7368048780487805\n","Iteration:  70\n","[8 1 7 ... 4 7 4] [8 8 7 ... 4 7 4]\n","0.7519024390243902\n","Iteration:  80\n","[8 1 7 ... 4 7 4] [8 8 7 ... 4 7 4]\n","0.763219512195122\n","Iteration:  90\n","[8 1 7 ... 4 7 4] [8 8 7 ... 4 7 4]\n","0.7737317073170732\n","Iteration:  100\n","[8 1 7 ... 4 7 4] [8 8 7 ... 4 7 4]\n","0.7813170731707317\n","Iteration:  110\n","[8 1 7 .